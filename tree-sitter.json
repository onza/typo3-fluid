{
  "grammars": [
    {
      "name": "fluid",
      "camelcase": "Fluid",
      "scope": "text.html.fluid",
      "file-types": [
        "fluid.html",
        "fluid.xml",
        "fluid.json",
        "fluid.txt"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^(fluid)$"
    }
  ],
  "metadata": {
    "version": "0.1.3",
    "license": "MIT",
    "description": "TYPO3 Fluid grammar for tree-sitter",
    "authors": [
      {
        "name": "Martin Farkas",
        "email": "info@martinfarkas.com"
      }
    ],
    "links": {
      "repository": "https://github.com/onza/typo3-fluid"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
